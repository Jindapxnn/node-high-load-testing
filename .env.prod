# --- Postgres Configuration ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=queue

# --- RabbitMQ Configuration ---
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin

# --- Connection Strings (สำหรับ API และ Worker) ---
# หมายเหตุ: เราใช้ชื่อ Service ใน Docker Compose เป็น Hostname
DATABASE_URL=postgresql://admin:admin@postgres_db:5432/queue
REDIS_URL=redis://redis_cache:6379
RABBITMQ_URL=amqp://admin:admin@rabbitmq_mq:5672

# --- App Config ---
PORT=4000
NODE_ENV=production
