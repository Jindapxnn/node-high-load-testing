generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id          Int      @id @default(autoincrement())
  username    String   @db.VarChar(100)
  
  // ใช้ @unique เพื่อป้องกันการบันทึกเลขคิวซ้ำในระดับ Database (Data Integrity)
  queueNumber Int      @unique @map("queue_number")
  
  // เก็บเวลาที่จองจริง
  createdAt   DateTime @default(now()) @map("created_at")

  // ตั้งชื่อ Table ใน Database เป็น "bookings"
  @@map("bookings")
}